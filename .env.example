# Copy to .env for local runs. Never commit real values.
# Where each one lives:  [R] Render environment  ·  [G] GitHub Actions secret

# --- Google Sheets (both) ---
GOOGLE_CREDENTIALS_JSON=          # [R][G] full JSON of the service account (arboles@...)
SPREADSHEET_NAME=Trees in space game Records   # optional

# --- GroupMe ---
GROUPME_BOT_ID=                   # [R][G] bot that posts in the group chat
BOT_NAME=Wild Palm Tree           # optional: messages from this name are ignored
WEBHOOK_TOKEN=                    # [R] optional (v2.0): secret the GroupMe callback URL must carry (?token=...)

# --- GitHub (bot -> Actions) ---
GH_DISPATCH_TOKEN=                # [R] fine-grained token, repo treebot, "Actions: Read and write" (ggs + daily job)
GH_REPO=AlexVerboo/treebot        # optional
DAILY_RUN_UTC=06:17               # optional (v2.0): time the bot starts "Update Halo records" (00:17 Mexico City)

# --- Halo Infinite (Actions only) ---
AZURE_CLIENT_ID=                  # [G] Azure app "TreeBot"
AZURE_CLIENT_SECRET=              # [G]
HALO_REFRESH_TOKEN=               # [G] from get_halo_token.py; renewed automatically in v2.0
GH_SECRETS_TOKEN=                 # [G] (v2.0) fine-grained token, repo treebot, "Secrets: Read and write"

# --- Alerts (v2.0) ---
DISCORD_ALERT_WEBHOOK=            # [R][G] webhook of the private #bot-alerts channel
ALERT_MIN_INTERVAL=600            # optional: seconds between repeated alerts of the same kind

# --- Database (v2.0): PostgreSQL on Neon ---
DATABASE_URL=                     # [R] pooled Neon string (host with -pooler, ?sslmode=require). Empty = no DB (v1 behavior)
                                  # [G] the secret is NEON_PROD_POOLER; workflows map it to DATABASE_URL
# NEON_DEV_POOLER=                # [G] optional: dev branch string, used by the "Database" workflow with target=dev
DB_CONNECT_TIMEOUT=10             # optional: seconds to wait for a connection
DB_POOL_MAX=4                     # optional: max pooled connections per process
DB_HEALTH_TIMEOUT=4               # optional [R]: seconds for the database check in /health?deep=1
INGEST_HOURS=48                   # optional: how far back each ingestion looks (also a GitHub variable)
INGEST_NEW_MEMBER_DAYS=30         # optional: history loaded automatically for new or returning members
INGEST_MAX_PAGES=40               # optional: history pages (25 matches each) per member and run
TEST_DATABASE_URL=                # local tests only: a THROWAWAY local Postgres (tests wipe it). Never Neon

# --- Tuning (GitHub variables, optional) ---
# MIN_GROUP_PLAYERS=5  ANNOUNCE_RECORDS=  STATS_SEASON=  GGS_MIN_PLAYERS=2  MATCHES_PER_PLAYER=25
